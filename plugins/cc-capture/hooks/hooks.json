{
  "description": "Capture the session into cc-warehouse on session end",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/ccw-hook.py",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
